docs/internal/

# Report-script run outputs: machine/runtime-specific, regenerated by the
# scripts that wrote them. A glob, not a list of paths — the list was four
# entries and a fifth output (benign_toolcalls/domains_last_run.json) showed up
# untracked because nobody added the line. Every scripts/*_report.py writes its
# summary to <dir>/[<prefix>_]last_run.json, so match the convention instead of
# enumerating it. Nothing tracked matches this (`git ls-files | grep last_run`
# is empty), and .gitignore does not affect already-tracked files, so a future
# file that genuinely belongs in the repo must be `git add -f`'d once.
**/*last_run.json

# Local symlinks some worktrees carry; never intended to be tracked.
.claude
.venv
