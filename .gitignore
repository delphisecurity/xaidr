# Held-out run outputs: machine/runtime-specific, regenerated by the scripts.
#
# A PATTERN, NOT A LIST. This was four exact paths, and a fifth run output --
# benign_toolcalls/domains_last_run.json, written by a throwaway instrument that
# was never committed -- sat untracked beside them. Harmless until 1.18.0, when
# the sdist started shipping the pool directories: hatchling honours .gitignore
# rather than git's index, so the four named here were excluded and the unnamed
# fifth was packaged into the distribution. Same enumeration failure as
# tests/test_install_hints.py's file list, one directory over.
*last_run.json
heldout/last_run.json
asi_battery/last_run.json
asi_battery/g4_last_run.json
benign_toolcalls/last_run.json
benign_toolcalls/domains_last_run.json

# Local symlinks some worktrees carry; never intended to be tracked.
.claude
.venv

# Long-form benign corpus: 10M characters, regenerated from the committed
# seed + generator and pinned by benign_longform/manifest.json.
benign_longform/corpus.jsonl
benign_longform/last_run.json
